{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Argument assessment response",
  "description": "Structured output from the provider-neutral argument assessment prompt. Participant averages are derived by the application, not the model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "turns",
    "conversation_summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "turns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/turn_assessment"
      }
    },
    "conversation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_disagreements",
        "strongest_arguments"
      ],
      "properties": {
        "key_disagreements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "strongest_arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "speaker_id",
              "argument_id",
              "explanation"
            ],
            "properties": {
              "speaker_id": {
                "type": "string",
                "minLength": 1
              },
              "argument_id": {
                "type": "string",
                "minLength": 1
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "turn_assessment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "turn_id",
            "speaker_id",
            "status",
            "reason"
          ],
          "properties": {
            "turn_id": {
              "type": "string",
              "minLength": 1
            },
            "speaker_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "const": "not_assessable"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "turn_id",
            "speaker_id",
            "status",
            "arguments"
          ],
          "properties": {
            "turn_id": {
              "type": "string",
              "minLength": 1
            },
            "speaker_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "const": "assessable"
            },
            "arguments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/argument_assessment"
              }
            }
          }
        }
      ]
    },
    "argument_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argument_id",
        "argument_excerpt",
        "criterion_scores",
        "overall_score",
        "score_band",
        "rationale",
        "evidence",
        "improvement_suggestion",
        "uncertainty"
      ],
      "properties": {
        "argument_id": {
          "type": "string",
          "minLength": 1
        },
        "argument_excerpt": {
          "type": "string",
          "minLength": 1
        },
        "criterion_scores": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "logic",
            "evidence",
            "relevance",
            "counterargument_handling"
          ],
          "properties": {
            "logic": {
              "$ref": "#/$defs/criterion_score"
            },
            "evidence": {
              "$ref": "#/$defs/criterion_score"
            },
            "relevance": {
              "$ref": "#/$defs/criterion_score"
            },
            "counterargument_handling": {
              "$ref": "#/$defs/criterion_score"
            }
          }
        },
        "overall_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "score_band": {
          "enum": [
            "very_weak",
            "weak",
            "mixed",
            "strong",
            "very_strong",
            null
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quote",
              "role",
              "criterion"
            ],
            "properties": {
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "strength",
                  "weakness",
                  "uncertainty"
                ]
              },
              "criterion": {
                "enum": [
                  "logic",
                  "evidence",
                  "relevance",
                  "counterargument_handling"
                ]
              }
            }
          }
        },
        "improvement_suggestion": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "reasons"
          ],
          "properties": {
            "level": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "criterion_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  }
}
